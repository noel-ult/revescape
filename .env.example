PORT=3001
NODE_ENV=production
# Set to your exact Dokploy HTTPS domain, without a trailing slash.
PUBLIC_ORIGIN=https://escape.example.com
# Optional solo objective selection. Both the flag and a server-side API key are required.
# Without these, selecting Luna replays the deterministic fallback.
LUNA_ENABLED=false
OPENAI_API_KEY=
# Daily rankings. Mount /app/data persistently in Dokploy; Compose config includes a volume.
DATA_DIR=./data
